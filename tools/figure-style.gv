// The look of every diagram written as Graphviz source ("dot") in a question's figure:
// the game's phosphor green on a transparent background, in its monospaced font.
// tools/render_figures.py adds the lines below right after a diagram's opening brace,
// so a diagram's own attributes override them. This file is part of each diagram's
// hash (comment lines aside), so after editing it, rerun the renderer.
bgcolor="transparent"; pad=0.2; fontname="Courier New"; fontcolor="#c8ffb0";
node [fontname="Courier New", fontsize=12, fontcolor="#c8ffb0", color="#00c840", shape=box, style=rounded, margin="0.15,0.08"];
edge [fontname="Courier New", fontsize=11, fontcolor="#c8ffb0", color="#5aaa5a", arrowsize=0.8];
