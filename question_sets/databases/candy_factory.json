{
  "name": "candy_factory",
  "about": "The Marchpane candy factory from Computing Concepts chapter 9: each candy once, and one row per batch made of it.",
  "tables": [
    {
      "name": "candies",
      "columns": [
        ["candy_id", "INTEGER PRIMARY KEY"],
        ["name", "TEXT"],
        ["maker", "TEXT"],
        ["sugar_grams", "INTEGER"]
      ]
    },
    {
      "name": "batches",
      "columns": [
        ["batch_id", "INTEGER PRIMARY KEY"],
        ["candy_id", "INTEGER REFERENCES candies(candy_id)"],
        ["made_on", "TEXT"]
      ]
    }
  ],
